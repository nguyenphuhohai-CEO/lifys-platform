PORT=3001
DATABASE_FILE=./data/lifys.sqlite
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development
TRUST_PROXY=0
APP_URL=http://localhost:3001
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Lifys <no-reply@lifys.com>
# ADMIN_EMAILS=admin@example.com
# REQUIRE_EMAIL_VERIFICATION=true
# SEED_DEMO_DATA=false

# Abonnement Premium (Stripe). Sans ces variables, le paiement reste désactivé.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint : POST /api/billing/webhook)
# PREMIUM_PRICE_CENTS=499
# PREMIUM_CURRENCY=eur

# Publicités (Google AdSense). Optionnel : sans ces variables, seuls des encarts internes sont affichés.
# Les publicités tierces ne se chargent qu'après consentement de l'utilisateur.
# ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# ADSENSE_SLOT_ID=1234567890

# Photos téléversées et sauvegardes (par défaut à côté de DATABASE_FILE : uploads/ et backups/)
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/data/backups
# BACKUP_INTERVAL_HOURS=24   (0 = désactivé ; 24 par défaut en production)
# BACKUP_KEEP=14

# Connexion sociale (callbacks : APP_URL/api/auth/oauth/google/callback et /facebook/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
