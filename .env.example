PORT=3001
APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
DATABASE_FILE=./data/lifys.sqlite
DATABASE_PROVIDER=sqlite
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
ALLOW_SQLITE_IN_PRODUCTION=false
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_COOKIE_NAME=lifys_refresh_token
CSRF_COOKIE_NAME=lifys_csrf_token
VITE_CSRF_COOKIE_NAME=lifys_csrf_token
EMAIL_DELIVERY_MODE=preview
RESEND_API_KEY=
EMAIL_FROM=noreply@lifys.app
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_MAX=60
DEMO_DISCOVERY_ENABLED=true
LOG_LEVEL=info
LOG_REQUESTS=true
TRUST_PROXY=false
FORCE_HTTPS=false
STATIC_ASSET_MAX_AGE_SECONDS=86400
