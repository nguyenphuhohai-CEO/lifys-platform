PORT=3001
APP_BASE_URL=https://app.lifys.example
VITE_API_BASE_URL=https://api.lifys.example
DATABASE_PROVIDER=postgres
DATABASE_URL=******postgres:5432/lifys
DATABASE_SSL=false
DATABASE_FILE=/var/lib/lifys/lifys.sqlite
ALLOW_SQLITE_IN_PRODUCTION=false
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
REFRESH_COOKIE_NAME=lifys_refresh_token
CSRF_COOKIE_NAME=lifys_csrf_token
VITE_CSRF_COOKIE_NAME=lifys_csrf_token
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=noreply@lifys.example
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
COOKIE_SECURE=true
CORS_ORIGIN=https://app.lifys.example
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_MAX=60
DEMO_DISCOVERY_ENABLED=false
LOG_LEVEL=info
LOG_REQUESTS=true
TRUST_PROXY=true
FORCE_HTTPS=true
STATIC_ASSET_MAX_AGE_SECONDS=86400
